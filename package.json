{
  "name": "boss-helper",
  "displayName": "BossHelper",
  "version": "0.0.1",
  "private": true,
  "description": "基于 Ocyss/boss-helper 改造的 Boss 直聘助手，减少投递简历的麻烦并提高投递效率",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox --mv3",
    "postinstall": "node scripts/wxt-run.mjs prepare",
    "check": "vue-tsc --noEmit",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:edge",
    "build:chrome": "node scripts/wxt-run.mjs build -b chrome",
    "build:firefox": "node scripts/wxt-run.mjs build -b firefox --mv3",
    "build:edge": "node scripts/wxt-run.mjs build -b edge",
    "zip": "npm run zip:chrome && npm run zip:firefox && npm run zip:edge",
    "zip:chrome": "node scripts/wxt-run.mjs zip -b chrome",
    "zip:firefox": "node scripts/wxt-run.mjs zip -b firefox --mv3",
    "zip:edge": "node scripts/wxt-run.mjs zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/integrations": "^14.4.0",
    "ai": "^7.0.58",
    "codejar": "^4.3.0",
    "comctx": "^1.7.5",
    "devlog-ui": "workspace:*",
    "idb": "^8.0.3",
    "mqtt": "^5.15.2",
    "partial-json": "^0.1.7",
    "serialize-error": "^13.0.1",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.41",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.2.0",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "proto2api": "^0.0.8",
    "protobufjs": "^8.7.2",
    "sass": "^1.99.0",
    "ts-proto": "^2.12.0",
    "typescript": "^6.0.3",
    "uid": "^2.0.2",
    "vite": "^8.0.16",
    "vite-plugin-tailwind-shadowdom": "^1.1.1",
    "vue-tsc": "^3.3.9",
    "wxt": "^0.21.3"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs,vue}": "oxlint --fix"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.9.9"
}
